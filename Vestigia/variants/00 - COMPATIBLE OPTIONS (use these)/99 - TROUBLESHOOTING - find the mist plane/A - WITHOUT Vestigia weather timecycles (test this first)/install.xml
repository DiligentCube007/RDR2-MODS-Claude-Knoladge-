    </Metadata>
    <ResourceGroups>
		<ResourceGroup name="Visual Essentials" scriptName="ess">
			<Description>The core visuals of the mod, essential to the VESTIGIA experience. Includes a complete timecycle overhaul, visualsettings.dat tweaks, new rain and snow particles. If you are planning to disable this, make sure you install the 'remove extra weathers' variant from the 'variants' folder.</Description>
			<Resources>
				<Resource>ess</Resource>
			</Resources>
		</ResourceGroup>
		<ResourceGroup name="Weather System" scriptName="wea">
			<Description>An altered weather system, with more realistic timecycle pathways as well as slower transitions.</Description>
			<Resources>
				<Resource>wea</Resource>
			</Resources>
		</ResourceGroup>
		<ResourceGroup name="Temperature Tweaks" scriptName="tem">
			<Description>More varied temperatures for different regions.</Description>
			<Resources>
				<Resource>tem</Resource>
			</Resources>
		</ResourceGroup>
				<ResourceGroup name="Visual Details" scriptName="det">
			<Description>Small, optional changes to visuals. Includes snow, tesselation and water related changes.</Description>
			<Resources>
				<Resource>det</Resource>
			</Resources>
		</ResourceGroup>
	</ResourceGroups>
